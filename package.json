{
  "name": "spacology",
  "private": true,
  "description": "Spacology prototypes, reusable systems, and playtest library.",
  "scripts": {
    "serve": "node tests/serve.cjs",
    "build:pages": "node tools/build-pages.cjs",
    "serve:pages": "node tests/serve.cjs --root dist",
    "test:pages": "node tests/pages-smoke.cjs",
    "test": "node tests/run.cjs",
    "test:unit": "node tests/run.cjs --unit",
    "test:browser": "node tests/run.cjs --browser",
    "test:balance": "node tests/run.cjs --balance"
  },
  "devDependencies": {
    "playwright": "1.61.1"
  }
}
